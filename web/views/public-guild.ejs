<%- include('partials/header') %>

<div class="guild-header">
  <img src="<%= botGuild.iconURL ? (botGuild.iconURL() || 'https://cdn.discordapp.com/embed/avatars/0.png') : 'https://cdn.discordapp.com/embed/avatars/0.png' %>" alt="" />
  <div>
    <h1>
      <%= botGuild.name %>
      <% if (guildRow.premium) { %><span class="badge badge-gold">Premium</span><% } %>
    </h1>
    <span style="color:var(--text-dim); font-size:0.9rem;">Moeda: <%= guildRow.currency_name %> (<%= guildRow.currency_symbol %>)</span>
  </div>
</div>

<section class="section" style="padding-top:0;">
  <h2 class="section-title">🏆 Ranking</h2>
  <table>
    <thead><tr><th>#</th><th>Membro</th><th>Total</th></tr></thead>
    <tbody>
      <% top.forEach(function(u, i) { %>
        <tr><td><%= i + 1 %></td><td><%= u.displayName %></td><td><%= (u.balance + u.bank).toLocaleString('pt-BR') %> <%= guildRow.currency_symbol %></td></tr>
      <% }) %>
      <% if (top.length === 0) { %><tr><td colspan="3" style="color:var(--text-dim)">Ninguém na economia ainda.</td></tr><% } %>
    </tbody>
  </table>
</section>

<section class="section">
  <h2 class="section-title">🛒 Loja</h2>
  <% if (items.length > 0) { %>
    <div class="grid">
      <% items.forEach(function(item) { %>
        <div class="card">
          <h3 style="margin-top:0;"><%= item.name %></h3>
          <p style="color:var(--text-dim);"><%= item.description || '&nbsp;' %></p>
          <strong><%= item.price %> <%= guildRow.currency_symbol %></strong>
        </div>
      <% }) %>
    </div>
  <% } else { %>
    <div class="empty-state">A loja deste servidor ainda está vazia.</div>
  <% } %>
</section>

<%- include('partials/footer') %>
