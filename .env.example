# --- Discord (obrigatório) ---
# Token do bot: https://discord.com/developers/applications -> seu app -> Bot -> Reset Token
DISCORD_TOKEN=
# Client ID: https://discord.com/developers/applications -> seu app -> OAuth2 -> Client ID
CLIENT_ID=
# Client Secret: mesma página do Client ID -> Client Secret (Reset Secret)
CLIENT_SECRET=
# Seu ID de usuário do Discord (ative o Modo Desenvolvedor e clique com botão direito no seu nome > Copiar ID)
# Só esse ID pode ativar/desativar Premium e ver o painel de dono.
OWNER_ID=

# --- Opcional ---
# ID de um servidor seu para registrar os comandos instantaneamente durante o desenvolvimento.
# Deixe vazio para registrar globalmente (demora até 1h para propagar, mas funciona em qualquer servidor).
GUILD_ID=

# URL pública onde o site vai rodar (usada no login com Discord). Em produção no Render, use a URL do serviço.
PUBLIC_URL=http://localhost:3000

# Porta do servidor web (o Render define isso sozinho, pode deixar em branco em produção)
PORT=3000

# Segredo aleatório para assinar os cookies de sessão do site. Gere um valor qualquer e longo.
SESSION_SECRET=troque-por-uma-string-aleatoria-e-longa

# Caminho do arquivo do banco de dados SQLite
DB_PATH=./data/economy.sqlite
