<%- include('partials/header') %>

<h1 style="margin-top:32px;">Painel do dono</h1>
<p style="color:var(--text-dim)">Ative ou desative o Premium em qualquer servidor que usa o bot.</p>

<% if (saved) { %><div class="alert alert-success">Alterações salvas.</div><% } %>

<table>
  <thead><tr><th>Servidor</th><th>Membros</th><th>Status</th><th>Validade</th><th>Ação</th></tr></thead>
  <tbody>
    <% rows.forEach(function(g) { %>
      <tr>
        <td>
          <strong><%= g.guild_name || g.guild_id %></strong><br>
          <span style="color:var(--text-dim); font-size:0.8rem;"><%= g.guild_id %></span>
          <% if (!g.present) { %><br><span class="badge badge-free">Bot removido</span><% } %>
        </td>
        <td><%= g.memberCount %></td>
        <td><% if (g.premium) { %><span class="badge badge-gold">Premium</span><% } else { %><span class="badge badge-free">Grátis</span><% } %></td>
        <td><%= g.premium_until ? new Date(g.premium_until).toLocaleDateString('pt-BR') : (g.premium ? 'Vitalício' : '—') %></td>
        <td>
          <form method="post" action="/owner/<%= g.guild_id %>/premium" class="inline-form" style="gap:6px;">
            <input type="number" name="days" placeholder="dias (vazio=vitalício)" min="1" style="width:170px;" />
            <button class="btn btn-gold btn-sm" type="submit" name="action" value="activate">Ativar</button>
            <button class="btn btn-danger btn-sm" type="submit" name="action" value="deactivate">Desativar</button>
          </form>
        </td>
      </tr>
    <% }) %>
    <% if (rows.length === 0) { %><tr><td colspan="5" style="color:var(--text-dim)">O bot ainda não está em nenhum servidor.</td></tr><% } %>
  </tbody>
</table>

<%- include('partials/footer') %>
