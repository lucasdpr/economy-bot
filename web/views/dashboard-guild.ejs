<%- include('partials/header') %>

<div class="guild-header">
  <img src="<%= botGuild.iconURL ? (botGuild.iconURL() || 'https://cdn.discordapp.com/embed/avatars/0.png') : 'https://cdn.discordapp.com/embed/avatars/0.png' %>" alt="" />
  <div>
    <h1>
      <%= botGuild.name %>
      <% if (guildRow.premium) { %><span class="badge badge-gold">Premium</span><% } else { %><span class="badge badge-free">Grátis</span><% } %>
    </h1>
    <a href="/g/<%= botGuild.id %>" target="_blank">Ver página pública do servidor →</a>
  </div>
</div>

<% if (saved) { %><div class="alert alert-success">Alterações salvas.</div><% } %>

<section class="section" style="padding-top:0;">
  <h2 class="section-title">Moeda do servidor</h2>
  <p class="section-sub">
    Atual: <strong><%= guildRow.currency_name %> (<%= guildRow.currency_symbol %>)</strong>
    <% if (!guildRow.premium) { %> — personalizar é um recurso <strong>Premium</strong><% } %>
  </p>
  <form method="post" action="/dashboard/<%= botGuild.id %>/settings" class="inline-form">
    <div class="form-row">
      <label>Nome da moeda</label>
      <input type="text" name="currency_name" value="<%= guildRow.currency_name %>" maxlength="32" <%= guildRow.premium ? '' : 'disabled' %> />
    </div>
    <div class="form-row">
      <label>Símbolo / emoji</label>
      <input type="text" name="currency_symbol" value="<%= guildRow.currency_symbol %>" maxlength="8" <%= guildRow.premium ? '' : 'disabled' %> />
    </div>
    <button class="btn btn-primary" type="submit" <%= guildRow.premium ? '' : 'disabled' %>>Salvar</button>
  </form>
</section>

<section class="section">
  <h2 class="section-title">Loja (<%= items.length %>/<%= shopLimit %>)</h2>
  <p class="section-sub">Itens que os membros podem comprar com <code>/loja comprar</code>. Um cargo é dado automaticamente se você definir um.</p>

  <% if (items.length > 0) { %>
    <table style="margin-bottom:24px;">
      <thead><tr><th>Item</th><th>Preço</th><th>Cargo</th><th>Estoque</th><th></th></tr></thead>
      <tbody>
        <% items.forEach(function(item) { %>
          <tr>
            <td><strong><%= item.name %></strong><% if (item.description) { %><br><span style="color:var(--text-dim); font-size:0.85rem;"><%= item.description %></span><% } %></td>
            <td><%= item.price %> <%= guildRow.currency_symbol %></td>
            <td><%= item.role_id ? ('@' + item.role_id) : '—' %></td>
            <td><%= item.stock < 0 ? 'Ilimitado' : item.stock %></td>
            <td>
              <form method="post" action="/dashboard/<%= botGuild.id %>/shop/remove/<%= item.id %>" onsubmit="return confirm('Remover este item da loja?');">
                <button class="btn btn-danger btn-sm" type="submit">Remover</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } else { %>
    <div class="empty-state" style="padding:24px 0;">Nenhum item cadastrado ainda.</div>
  <% } %>

  <% if (items.length < shopLimit) { %>
    <form method="post" action="/dashboard/<%= botGuild.id %>/shop/add" class="card">
      <h3 style="margin-top:0;">Adicionar item</h3>
      <div class="inline-form">
        <div class="form-row"><label>Nome</label><input type="text" name="name" required maxlength="64" /></div>
        <div class="form-row"><label>Preço</label><input type="number" name="price" required min="1" /></div>
        <div class="form-row"><label>Estoque (vazio = ilimitado)</label><input type="number" name="stock" min="1" /></div>
      </div>
      <div class="form-row" style="margin-top:12px;"><label>Descrição (opcional)</label><textarea name="description" maxlength="200"></textarea></div>
      <div class="form-row"><label>ID do cargo do Discord a dar ao comprar (opcional)</label><input type="text" name="role_id" placeholder="Ex: 123456789012345678" /></div>
      <button class="btn btn-primary" type="submit" style="margin-top:8px;">Adicionar à loja</button>
    </form>
  <% } else { %>
    <div class="alert alert-error">Limite de <%= shopLimit %> itens atingido no plano <%= guildRow.premium ? 'Premium' : 'Grátis' %>.</div>
  <% } %>
</section>

<section class="section">
  <h2 class="section-title">Ranking (top 10)</h2>
  <table>
    <thead><tr><th>#</th><th>Usuário</th><th>Total</th></tr></thead>
    <tbody>
      <% top.forEach(function(u, i) { %>
        <tr><td><%= i + 1 %></td><td><%= u.username || u.user_id %></td><td><%= (u.balance + u.bank).toLocaleString('pt-BR') %> <%= guildRow.currency_symbol %></td></tr>
      <% }) %>
      <% if (top.length === 0) { %><tr><td colspan="3" style="color:var(--text-dim)">Ninguém na economia ainda.</td></tr><% } %>
    </tbody>
  </table>
</section>

<%- include('partials/footer') %>
